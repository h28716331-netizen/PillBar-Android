<?xml version="1.0" encoding="utf-8"?>
<!--
  AccessibilityService 配置：
  - canPerformGestures="false"（关键：开启 true 会在 Android 16 上导致系统手势导航失效）
  - v3 触摸方案：小白条窗口自接收触摸但 onTouchEvent 返回 false 不消费，
    事件继续派发给系统手势层，系统原生动画不受影响
  - canTakeScreenshot 以支持 takeScreenshot() 自适应黑白
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canPerformGestures="false"
    android:canRequestFilterKeyEvents="false"
    android:canRetrieveWindowContent="false"
    android:canTakeScreenshot="true"
    android:notificationTimeout="100"
    android:summary="@string/accessibility_summary"
    android:description="@string/accessibility_description" />
